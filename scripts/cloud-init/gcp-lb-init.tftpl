#!/bin/bash
#==========================================================
# Cloud-Init Script for Load Balancing Demo - GCP On-Prem
# VM: cloudflare-lb-demo-onprem-gcp
#==========================================================

set -euxo pipefail

LOGFILE="/var/log/lb-demo-startup.log"
exec > >(tee -a "$LOGFILE") 2>&1

echo "=========================================="
echo "LB Demo Startup Script - GCP On-Prem"
echo "Started at $(date)"
echo "=========================================="

# Wait for network connectivity
until ping -c1 8.8.8.8 &>/dev/null; do
    echo "Waiting for network..."
    sleep 5
done

# Set timezone
timedatectl set-timezone Europe/Paris

# Update and install packages
echo "Installing required packages..."
apt-get update -y
apt-get install -y wget curl nginx gnupg2

#==========================================================
# Configure Nginx Web Server
#==========================================================
echo "Configuring Nginx web server..."

# Create web directory
mkdir -p /var/www/swiss-insurance

# Create the Swiss Insurance HTML page with dynamic server info
cat > /var/www/swiss-insurance/index.html << 'HTMLEOF'
${swiss_insurance_html}
HTMLEOF

# Replace placeholders with actual server information
sed -i 's/LOCATION_PLACEHOLDER/GCP Europe-West3 (Frankfurt)/g' /var/www/swiss-insurance/index.html
sed -i 's/DATACENTER_PLACEHOLDER/On-Premises (Simulated)/g' /var/www/swiss-insurance/index.html
sed -i 's/HOSTNAME_PLACEHOLDER/${hostname}/g' /var/www/swiss-insurance/index.html

# Configure Nginx
cat > /etc/nginx/sites-available/swiss-insurance << 'NGINXEOF'
server {
    listen ${lb_web_port} default_server;
    listen [::]:${lb_web_port} default_server;

    root /var/www/swiss-insurance;
    index index.html;

    server_name _;

    # Add headers to identify the origin server
    add_header X-Served-By "${hostname}" always;
    add_header X-Origin-Datacenter "GCP-OnPrem" always;
    add_header X-Origin-Region "europe-west3" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Health check endpoint for load balancer
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
NGINXEOF

# Enable the site
ln -sf /etc/nginx/sites-available/swiss-insurance /etc/nginx/sites-enabled/
rm -f /etc/nginx/sites-enabled/default

# Test and restart Nginx
nginx -t
systemctl restart nginx
systemctl enable nginx

echo "Nginx configured and running on port ${lb_web_port}"

#==========================================================
# Install and Configure Cloudflared
#==========================================================
echo "Installing cloudflared..."

wget https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb
dpkg -i cloudflared-linux-amd64.deb

echo "Configuring cloudflared service..."
cloudflared service install ${tunnel_token}
systemctl restart cloudflared.service
systemctl enable cloudflared.service

# Wait for cloudflared to connect
sleep 10
systemctl status cloudflared.service --no-pager || true

#==========================================================
# Install Datadog Agent (Optional)
#==========================================================
echo "Installing Datadog Agent..."
DD_API_KEY=${datadog_api_key} DD_SITE=${datadog_region} bash -c "$(curl -L https://install.datadoghq.com/scripts/install_script_agent7.sh)"

# Wait for agent installation
sleep 10

# Configure Datadog
cat >> /etc/datadog-agent/datadog.yaml << 'DDEOF'
process:
  enabled: true

tags:
  - environment:zero-trust-demo
  - cloud:gcp
  - role:lb-demo
  - datacenter:onprem
  - managed-by:terraform
DDEOF

# Restart Datadog agent
systemctl restart datadog-agent

echo "=========================================="
echo "LB Demo Setup Completed Successfully!"
echo "Hostname: ${hostname}"
echo "Web Server: http://localhost:${lb_web_port}"
echo "Completed at $(date)"
echo "=========================================="
